{
  "name": "smart-hackathon-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "start:reference": "node --env-file-if-exists=.env --import tsx src/main.ts --reference",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
